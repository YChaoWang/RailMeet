  "cards": [
    {
      "dot": "cyan",
      "title": "Public HTTP",
      "items": [
        "GET /meeting-searches/:id, …/results, …/journeys/:id, /places/search, /map/stops",
        "Create is 202 after Postgres only; GET results never calls Redis, BullMQ, or /plan"
      ]
    },
    {
      "dot": "emerald",
      "title": "Outbox and writes",
      "items": [
        "Dispatcher claims the outbox, then kickoff → candidates → routing → finalization",
        "Routing is the only /plan caller; finalization writes rankAllModes; API geocode/stops are off-spine"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust",
      "items": [
        "Web and API are public; Redis and the four consumers are not",
        "apps/api must not import @railmeet/queue or call /plan"
      ]
    }
  ]
