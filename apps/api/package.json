{
  "name": "@railmeet/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@railmeet/config": "workspace:*",
    "@railmeet/database": "workspace:^",
    "@railmeet/observability": "workspace:*",
    "@railmeet/shared": "workspace:^",
    "@railmeet/validation": "workspace:^",
    "fastify": "^5.4.0",
    "fastify-type-provider-zod": "4.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
