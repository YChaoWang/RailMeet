{
  "name": "@railmeet/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@railmeet/catalog": "workspace:^",
    "@railmeet/config": "workspace:*",
    "@railmeet/database": "workspace:^",
    "@railmeet/observability": "workspace:*",
    "@railmeet/queue": "workspace:^",
    "@railmeet/routing": "workspace:^",
    "@railmeet/search-engine": "workspace:^",
    "@railmeet/shared": "workspace:^"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.28.0",
    "@testcontainers/redis": "^10.28.0",
    "bullmq": "^5.81.3",
    "drizzle-orm": "^0.45.2",
    "testcontainers": "^10.28.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
