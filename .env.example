# Shared
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://railmeet:railmeet@localhost:5432/railmeet

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# HTTP API
API_HOST=0.0.0.0
API_PORT=3001
API_BASE_URL=http://localhost:3001

# Next.js web app
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Transitous (routing provider; unused until a later phase)
TRANSITOUS_BASE_URL=https://api.transitous.org

# Outbox dispatcher (worker). Defaults are safe if omitted.
# OUTBOX_POLL_INTERVAL_MS=1000
# OUTBOX_BATCH_SIZE=10
# OUTBOX_LEASE_MS=60000
# OUTBOX_RETRY_BASE_MS=1000
# OUTBOX_RETRY_MAX_MS=60000
# OUTBOX_PUBLISH_CONCURRENCY=3
