# Shared
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://railmeet:railmeet@localhost:5432/railmeet

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# HTTP API
API_HOST=0.0.0.0
API_PORT=3001
API_BASE_URL=http://localhost:3001

# Next.js web app
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Transitous (routing provider; unused until Phase 6)
TRANSITOUS_BASE_URL=https://api.transitous.org
