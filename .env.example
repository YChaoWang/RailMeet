# Shared
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://railmeet:railmeet@localhost:5432/railmeet
# Direct Neon connection for migrations and catalog import (omit locally to use DATABASE_URL)
# DATABASE_URL_DIRECT=postgresql://...

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# HTTP API
API_HOST=0.0.0.0
API_PORT=3001
API_BASE_URL=http://localhost:3001
# Comma-separated browser origins for CORS (production Vercel + local dev)
# WEB_ORIGIN=http://localhost:3000,https://your-app.vercel.app

# Next.js web app
WEB_PORT=3000
# Server-only Fastify base URL used by Next.js Route Handlers (not exposed to the browser)
# NEXT_PUBLIC_API_BASE_URL is optional when using same-origin Route Handlers
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Transitous MOTIS 2 (official public API root includes /api)
TRANSITOUS_BASE_URL=https://api.transitous.org/api
# TRANSITOUS_USER_AGENT=RailMeet/0.0.0 (+https://github.com/example/railmeet)
# TRANSITOUS_TIMEOUT_MS=10000

# Outbox dispatcher (worker). Defaults are safe if omitted.
# OUTBOX_POLL_INTERVAL_MS=1000
# OUTBOX_BATCH_SIZE=10
# OUTBOX_LEASE_MS=60000
# OUTBOX_RETRY_BASE_MS=1000
# OUTBOX_RETRY_MAX_MS=60000
# OUTBOX_PUBLISH_CONCURRENCY=3

# Search kickoff consumer + job retention (new jobs only)
# SEARCH_CONSUMER_CONCURRENCY=2
# SEARCH_CANDIDATE_CONSUMER_CONCURRENCY=2
# SEARCH_ROUTING_CONSUMER_CONCURRENCY=2
# SEARCH_FINALIZATION_CONSUMER_CONCURRENCY=2
# SEARCH_CANDIDATE_LIMIT=3
# SEARCH_JOB_ATTEMPTS=5
# SEARCH_JOB_BACKOFF_DELAY_MS=2000
# SEARCH_JOB_BACKOFF_JITTER=0.2
# SEARCH_JOB_REMOVE_ON_COMPLETE_AGE_SECONDS=3600
# SEARCH_JOB_REMOVE_ON_COMPLETE_COUNT=1000
# SEARCH_JOB_REMOVE_ON_FAIL_AGE_SECONDS=86400
# SEARCH_JOB_REMOVE_ON_FAIL_COUNT=5000
# WORKER_SHUTDOWN_TIMEOUT_MS=30000
