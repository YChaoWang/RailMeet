{
  "name": "@railmeet/catalog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "catalog:validate": "tsx src/cli.ts validate --source fixture",
    "catalog:download": "tsx src/cli.ts download",
    "catalog:build": "tsx src/cli.ts build",
    "catalog:enrich-hubs": "tsx src/cli.ts enrich-hubs",
    "catalog:remap-hub-ids": "tsx src/cli.ts remap-hub-ids",
    "catalog:cleanup-fixture": "tsx src/cli.ts cleanup-fixture",
    "catalog:import": "tsx src/cli.ts import",
    "catalog:status": "tsx src/cli.ts status",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@railmeet/database": "workspace:^",
    "@railmeet/shared": "workspace:^",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.28.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
